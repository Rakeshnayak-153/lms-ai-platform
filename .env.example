# ==============================================================================
# Environment Configuration Template for LMS-AI
# ==============================================================================

# Core Database & Cache
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=lms_ai_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/lms_ai_db

REDIS_HOST=localhost
REDIS_PORT=6379

# Backend Settings
PORT=5000
NODE_ENV=development
JWT_ACCESS_SECRET=super_secret_access_key_change_in_production
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
CORS_ORIGIN=http://localhost:3000

# AI Tutor Service
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000
ANTHROPIC_API_KEY=your_anthropic_api_key_here
EMBEDDING_MODEL=text-embedding-3-small

# S3 / MinIO Object Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=password123
S3_BUCKET_NAME=lms-assets
S3_REGION=us-east-1

# Frontend Settings
VITE_API_URL=http://localhost:5000/api/v1
VITE_AI_URL=http://localhost:8000
